{
  "routes": [
    { "route": "/ledskarmar", "rewrite": "/ledskarmar.html" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/ledskarmar.html", "/*.png", "/*.svg", "/*.css", "/*.js"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "cache-control": "public, max-age=3600"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webp": "image/webp",
    ".svg": "image/svg+xml"
  }
}
