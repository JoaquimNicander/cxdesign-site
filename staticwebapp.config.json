{
  "routes": [
    {
      "route": "/smartcraft/admin",
      "rewrite": "/smartcraft/admin.html",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/smartcraft",
      "rewrite": "/smartcraft/index.html"
    },
    {
      "route": "/projekt.html",
      "headers": {
        "cache-control": "no-store, must-revalidate"
      }
    },
    {
      "route": "/projekt-admin.html",
      "headers": {
        "cache-control": "no-store, must-revalidate"
      }
    },
    {
      "route": "/k/*",
      "rewrite": "/xlbygg/index.html"
    },
    {
      "route": "/ledskarmar",
      "rewrite": "/ledskarmar.html"
    },
    {
      "route": "/allstrings",
      "rewrite": "/allstrings/index.html"
    },
    {
      "route": "/xlbygg/k/*",
      "rewrite": "/xlbygg/index.html"
    },
    {
      "route": "/xlbygg",
      "rewrite": "/xlbygg/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/smartcraft/*",
      "/k/*",
      "/allstrings/*",
      "/xlbygg/*",
      "/ledskarmar.html",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.webp",
      "/*.svg",
      "/*.css",
      "/*.js"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "cache-control": "public, max-age=3600"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webp": "image/webp",
    ".svg": "image/svg+xml",
    ".mp4": "video/mp4",
    ".jpg": "image/jpeg"
  }
}
